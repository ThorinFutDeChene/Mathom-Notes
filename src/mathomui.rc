<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE kpartgui SYSTEM "kpartgui.dtd">
<gui name="basket" version="7">
 <MenuBar noMerge="1" >
  <Menu name="basket" >
   <text>&amp;Mathom-House</text>
   <Action name="basket_new_menu" />
   <Separator/>
   <Action name="basket_properties" />
   <Menu icon="document-export" >
    <text>&amp;Export</text>
    <Action name="basket_export_basket_archive" />
    <Action name="basket_export_html" />
   </Menu>
   <Menu icon="view-sort-ascending" >
    <text>&amp;Sort</text>
    <Action name="basket_sort_children_asc" />
    <Action name="basket_sort_children_desc" />
    <Action name="basket_sort_siblings_asc" />
    <Action name="basket_sort_siblings_desc" />
   </Menu>
   <Action name="basket_remove" />
   <Separator/>
   <Action name="basket_password" />
   <Action name="basket_lock" />
   <Separator/>
   <Menu name="fileimport" icon="document-import" >
    <text>&amp;Import</text>
    <Action name="basket_import_basket_archive" />
    <Action name="basket_import_text_file" />
   </Menu>
   <Action name="basket_backup_restore" />
   <Separator/>
   <Action name="check_cleanup" />
   <Separator/>
   <Action name="window_hide" />
   <Action name="file_quit" />
  </Menu>
  <Menu name="edit" >
   <text>&amp;Edit</text>
   <Action name="richtext_undo" />
   <Action name="richtext_redo" />
   <Separator/>
   <Action name="edit_cut" />
   <Action name="edit_copy" />
   <Action name="edit_paste" />
   <Action name="edit_delete" />
   <Separator/>
   <Action name="edit_select_all" />
   <Action name="edit_unselect_all" />
   <Action name="edit_invert_selection" />
   <Separator/>
   <Action name="edit_filter" />
   <Action name="edit_filter_all_baskets" />
   <Action name="edit_filter_reset" />
  </Menu>
  <Menu name="go" >
   <text>&amp;Go</text>
   <Action name="go_basket_fold" />
   <Action name="go_basket_expand" />
  </Menu>
  <Menu name="note" >
   <text>&amp;Mathom</text>
   <Action name="note_edit" />
   <Action name="note_open" />
   <Action name="note_open_with" />
   <Action name="note_save_to_file" />
   <Action name="note_clear" />
   <Separator/>
   <Action name="note_group" />
   <Action name="note_ungroup" />
   <Separator/>
   <Action name="note_move_top" />
   <Action name="note_move_up" />
   <Action name="note_move_down" />
   <Action name="note_move_bottom" />
  </Menu>
  <Menu name="tags" >
   <text>&amp;Tags</text>
  </Menu>
  <Menu name="insert" >
   <text>&amp;Insert</text>
   <Action name="insert_html" />
   <Action name="insert_image" />
   <Action name="insert_spreadsheet" />
   <Action name="insert_link" />
   <Action name="insert_cross_reference" />
   <Action name="insert_launcher" />
   <Action name="insert_color" />
   <Separator/>
   <Action name="insert_screen_capture" />
   <Action name="insert_screen_color" />
   <Separator/>
   <Action name="insert_from_file" />
   <Action name="insert_kmenu" />
   <Action name="insert_icon" />
  </Menu>
  <Menu name="settings" >
   <text>&amp;Settings</text>
   <Merge name="StandardToolBarMenuHandler" />
   <Action name="options_show_statusbar" />
   <Separator/>
   <Action name="options_configure_keybinding" />
   <Action name="options_configure_global_keybinding" />
   <Action name="options_configure_toolbars" />
   <Action name="options_configure_notifications" />
   <Action name="options_update_settings" />
   <Action name="options_configure" />
  </Menu>
  <Menu name="profile">
    <text>&amp;Profil</text>
    <Action name="profile_dyslexia" />
    <Action name="profile_dysorthography" />
    <Action name="profile_dysgraphia" />
    <Action name="profile_dyspraxia" />
    <Action name="profile_dysphasia" />
    <Action name="profile_dyscalculia" />
    <Action name="profile_adhd" />
    <Separator/>
    <Action name="profile_custom" />
  </Menu>
  <Menu name="help" >
   <text>&amp;Help</text>
   <Action name="help_contents" />
   <Action name="help_plugins_contents" />
   <Action name="help_whats_this" />
   <Action name="help_show_tip" />
   <Separator/>
   <Action name="help_welcome_baskets" />
   <Action name="help_check_updates" />
   <Action name="help_open_diagnostics" />
   <Separator/>
   <Action name="help_about_mathom" />
   <Action name="help_about_thorinux" />
  </Menu>
 </MenuBar>
 <ToolBar newline="false" position="Top" noMerge="1" name="mainToolBar" fullWidth="true" >
  <text>Main Toolbar</text>

  <!-- Zone 1: prise de notes immediate -->
  <Action name="basket_new_menu" />
  <Action name="richtext_undo" />
  <Action name="richtext_redo" />

  <Separator lineSeparator="true" name="toolbar_zone_1" />

  <!-- Zone 2: mise en forme courante -->
  <Action name="richtext_bold" />
  <Action name="richtext_italic" />
  <Action name="richtext_underline" />
  <Action name="richtext_super" />
  <Action name="richtext_sub" />
  <Action name="richtext_color" />

  <Separator lineSeparator="true" name="toolbar_zone_2" />

  <!-- Zone 3: police -->
  <Action name="richtext_font" />
  <Separator lineSeparator="false" name="toolbar_font_spacing" />
  <Action name="richtext_font_size" />

  <Separator lineSeparator="true" name="toolbar_zone_3" />

  <!-- Zone 4: mise en page -->
  <Action name="richtext_left" />
  <Action name="richtext_center" />
  <Action name="richtext_right" />
  <Action name="richtext_block" />

  <Separator lineSeparator="true" name="toolbar_zone_4" />

  <!-- Zone 5: manipulation -->
  <Action name="edit_cut" />
  <Action name="edit_copy" />
  <Action name="edit_paste" />
  <Action name="edit_delete" />

  <Separator lineSeparator="true" name="toolbar_zone_5" />

  <!-- Zone 6: fonctions secondaires -->
  <Action name="note_group" />
  <Action name="edit_filter" />
  <Action name="edit_filter_all_baskets" />
  <Action name="basket_properties" />
 </ToolBar>
 <Menu name="basket_popup" >
  <Action name="basket_new_menu" />
  <Separator/>
  <Action name="basket_properties" />
  <Menu icon="document-export" >
   <text>&amp;Export</text>
   <Action name="basket_export_basket_archive" />
   <Action name="basket_export_html" />
  </Menu>
  <Menu icon="view-sort-ascending" >
   <text>&amp;Sort</text>
   <Action name="basket_sort_children_asc" />
   <Action name="basket_sort_children_desc" />
   <Action name="basket_sort_siblings_asc" />
   <Action name="basket_sort_siblings_desc" />
  </Menu>
  <Action name="basket_remove" />
  <Separator/>
  <Action name="basket_password" />
  <Action name="basket_lock" />
  <Separator/>
  <Menu icon="document-import" >
   <text>&amp;Import</text>
   <Action name="basket_import_basket_archive" />
   <Action name="basket_import_text_file" />
  </Menu>
  <Action name="basket_backup_restore" />
  <Separator/>
  <Action name="check_cleanup" />
 </Menu>
 <Menu name="tab_bar_popup" >
  <Action name="basket_new" />
  <Menu icon="document-import" >
   <text>&amp;Import</text>
   <Action name="basket_import_basket_archive" />
   <Action name="basket_import_text_file" />
  </Menu>
  <Action name="basket_backup_restore" />
  <Separator/>
  <Action name="check_cleanup" />
 </Menu>
 <Menu noMerge="1" name="note_popup" >
  <Action name="note_edit" />
  <Action name="note_open" />
  <Action name="note_open_with" />
  <Action name="note_save_to_file" />
  <Action name="note_clear" />
  <Separator/>
  <Action name="note_group" />
  <Action name="note_ungroup" />
  <Separator/>
  <Action name="edit_cut" />
  <Action name="edit_copy" />
  <Action name="edit_delete" />
 </Menu>
 <Menu noMerge="1" name="insert_popup" >
  <Action name="insert_html" />
  <Action name="insert_image" />
  <Action name="insert_link" />
  <Action name="insert_cross_reference" />
  <Action name="insert_launcher" />
  <Action name="insert_color" />
  <Separator/>
  <Action name="insert_screen_capture" />
  <Action name="insert_screen_color" />
  <Separator/>
  <Action name="insert_from_file" />
  <Action name="insert_kmenu" />
  <Action name="insert_icon" />
  <Separator/>
  <Action name="edit_paste" />
 </Menu>
</gui>
