#: src/tagsedit.cpp:330
#, kde-format
msgid ""
"This option will enable you to type a cross reference link directly into a "
"text mathom. Cross Reference links can have the following syntax:"
msgstr ""
"Ĉi tiu opcio ebligas rekte tajpi interreferencan ligilon en tekstan "
"mathomon. Interreferencaj ligiloj povas havi jenan sintakson:"

#: src/tagsedit.cpp:331
#, kde-format
msgid "From the top of the tree (Absolute path):"
msgstr "De la supro de la arbo (Absoluta vojo):"

#: src/tagsedit.cpp:332
#, kde-format
msgid "[[/top level item/child|optional title]]"
msgstr "[[/pintnivela ero/ido|laŭvola titolo]]"

#: src/tagsedit.cpp:332
#, kde-format
msgid "Relative to the current location:"
msgstr "Rilate al la nuna loko:"

#: src/tagsedit.cpp:333
#, kde-format
msgid "[[../sibling|optional title]]"
msgstr "[[../frato|laŭvola titolo]]"

#: src/tagsedit.cpp:333
#, kde-format
msgid "[[child|optional title]]"
msgstr "[[infano|laŭvola titolo]]"

#: src/tagsedit.cpp:334
#, kde-format
msgid "[[./child|optional title]]"
msgstr "[[./infano|laŭvola titolo]]"

#: src/tagsedit.cpp:335
#, kde-format
msgid "Location matching is cAse inSEnsItive."
msgstr "La serĉado de kongruaj lokoj ne distingas inter majuskloj kaj minuskloj."

