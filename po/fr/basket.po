msgstr "[[../fratrie|titre optionnel]]"

#: src/tagsedit.cpp:333
#, kde-format
msgid "[[child|optional title]]"
msgstr "[[enfant|titre optionnel]]"

#: src/tagsedit.cpp:334
#, kde-format
msgid "[[./child|optional title]]"
