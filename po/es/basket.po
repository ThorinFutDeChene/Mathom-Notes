#: src/tagsedit.cpp:330
#, kde-format
msgid ""
"This option will enable you to type a cross reference link directly into a "
"text mathom. Cross Reference links can have the following syntax:"
msgstr ""
"Esta opción permite escribir directamente un enlace de referencia cruzada "
"en un mathom de texto. Los enlaces de referencia cruzada pueden tener la "
"siguiente sintaxis:"

#: src/tagsedit.cpp:331
#, kde-format
msgid "From the top of the tree (Absolute path):"
msgstr "Desde la parte superior del árbol (ruta absoluta):"

#: src/tagsedit.cpp:332
#, kde-format
msgid "[[/top level item/child|optional title]]"
msgstr "[[/elemento superior/hijo|título opcional]]"

#: src/tagsedit.cpp:332
#, kde-format
msgid "Relative to the current location:"
msgstr "Relativo a la ubicación actual:"

#: src/tagsedit.cpp:333
#, kde-format
msgid "[[../sibling|optional title]]"
msgstr "[[../hermano|título opcional]]"

#: src/tagsedit.cpp:333
#, kde-format
msgid "[[child|optional title]]"
msgstr "[[hijo|título opcional]]"

#: src/tagsedit.cpp:334
#, kde-format
msgid "[[./child|optional title]]"
msgstr "[[./hijo|título opcional]]"

#: src/tagsedit.cpp:335
#, kde-format
msgid "Location matching is cAse inSEnsItive."
msgstr "La búsqueda de ubicaciones no distingue entre mayúsculas y minúsculas."

